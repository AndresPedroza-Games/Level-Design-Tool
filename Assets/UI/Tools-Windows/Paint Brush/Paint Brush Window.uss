:root {
    background-color: rgb(3, 6, 29);
    padding-top: 10px;
    padding-right: 10px;
    padding-bottom: 10px;
    padding-left: 10px;
}

.Text {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-outline-color: rgb(255, 255, 255);
    -unity-text-outline-width: 0;
    -unity-text-align: middle-left;
    font-size: 19px;
    text-shadow: 0 0 0 rgb(255, 255, 255);
}

.Body {
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    background-color: rgba(3, 5, 26, 0);
    flex-grow: 1;
    max-height: 60%;
}

.Header-Btn {
    width: 60px;
    height: 20px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    -unity-font-style: bold;
    font-size: 12px;
    color: rgb(255, 255, 255);
    background-color: rgb(2, 42, 91);
    border-left-color: rgb(248, 248, 248);
    border-right-color: rgb(248, 248, 248);
    border-top-color: rgb(248, 248, 248);
    border-bottom-color: rgb(248, 248, 248);
}

.Settings {
    background-color: rgba(51, 46, 46, 0.38);
    margin-top: 10px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    max-height: none;
    margin-bottom: 0;
}

.Color-Setting {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.unity-base-field__label {
    display: none;
}

.unity-base-field__input {
    background-color: rgba(3, 28, 60, 0.73);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
}

.Radius {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: auto;
}

.settings-titel {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 21px;
    padding-left: 5px;
    margin-bottom: 10px;
}

.setting-container {
    background-color: rgba(79, 79, 79, 0.8);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    margin-bottom: 5px;
    margin-top: 5px;
    padding-left: 5px;
    padding-right: 5px;
    max-height: 20%;
}

.filters {
    flex-grow: 1;
    max-height: 30%;
}

.header {
    flex-grow: 1;
    max-height: 10%;
}

.unity-color-field {
    min-width: 30%;
    min-height: 50%;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-top-width: 0.5px;
    border-right-width: 0.5px;
    border-bottom-width: 0.5px;
    border-left-width: 0.5px;
}

.unity-integer-field {
    min-width: 10%;
    min-height: 60%;
}

.unity-text-element--inner-input-field-component {
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    font-size: 17px;
}

.unity-slider {
    min-width: auto;
    flex-grow: 1;
    min-height: 40%;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-top-width: 0.5px;
    border-right-width: 0.5px;
    border-bottom-width: 0.5px;
    border-left-width: 0.5px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    justify-content: flex-start;
    align-items: flex-start;
    margin-right: 10px;
    margin-left: 10px;
}



.unity-base-slider__input {
    align-self: auto;
    background-color: rgba(3, 28, 60, 0.73);
}

.unity-base-slider--horizontal .unity-base-slider__tracker {
    background-color: rgba(147, 195, 209, 0.83);
    min-width: auto;
    min-height: 20%;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
    border-bottom-left-radius: 2px;
    margin-right: 5px;
    margin-left: 5px;
}

.unity-base-slider__dragger {
    background-color: rgb(255, 255, 255);
}
