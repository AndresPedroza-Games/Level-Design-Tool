:root {
}

.Filter {
    background-color: rgba(51, 46, 46, 0.38);
    margin-top: 10px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
}

.Filter-Text {
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-text-outline-color: rgb(24, 64, 113);
    -unity-text-outline-width: 0;
    font-size: 16px;
}

.Filter-Setting {
    justify-content: space-between;
    align-items: center;
    visibility: visible;
    flex-direction: row;
}

.unity-base-field__label {
    display: none;
}

.Filter-Setting-Selector {
    width: 50%;
    height: 60%;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
}

.unity-base-field__input {
    background-color: rgba(3, 28, 60, 0.73);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
}

.unity-text-element--inner-input-field-component {
    color: rgb(255, 255, 255);
    font-size: 12px;
    -unity-font-style: normal;
}

.unity-base-field {
}

.unity-text-field {
}

.unity-base-text-field {
}

.unity-popup-field {
}

.unity-base-popup-field {
}





.Text {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    -unity-text-outline-color: rgb(255, 255, 255);
    -unity-text-outline-width: 0;
    -unity-text-align: middle-left;
    font-size: 12px;
    text-shadow: 0 0 0 rgb(255, 255, 255);
}
